# Port the API listens on
PORT=3002
# Allowed CORS origin (the frontend)
CORS_ORIGIN=http://localhost:3000
# Directory for JSON persistence (default: backend/data)
DATA_DIR=./data
# Max POST requests per IP per window
RATE_LIMIT_MAX=10
# Rate limit window in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# CORS_ORIGIN accepts a comma-separated list, e.g.
#   CORS_ORIGIN=https://my-frontend.vercel.app,http://localhost:3000
# Redis storage (used instead of JSON files when both are set; Vercel Marketplace Upstash
# Redis provides either pair). Leave unset locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
